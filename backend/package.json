{
  "name": "civic-events-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Civic events backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node migrations/run.js 001_create_tables.sql && node migrations/run.js 003_service_requests.sql",
    "db:seed": "node migrations/run.js 002_seed_data.sql",
    "db:reset": "npm run db:setup && npm run db:seed"
  },
